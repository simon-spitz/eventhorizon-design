---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CallToAction from "../../components/CallToAction.astro";

const areas = [
  {
    number: "01",
    title: "Business analysis",
    intro: "Work out what the project really needs.",
    text: "I speak to the people involved, look at the current process and separate needs from assumptions. We end up with clear requirements and a sensible basis for decisions.",
  },
  {
    number: "02",
    title: "Digital project management",
    intro: "Keep the work organised from brief to handover.",
    text: "I plan the work, keep decisions and risks visible, coordinate the people involved and follow up on what has been agreed. I can manage the whole project or step in at a particular stage.",
  },
  {
    number: "03",
    title: "Website project management",
    intro: "Handle the website as a project, not just a build.",
    text: "Website projects involve content, design, technology and decisions from several people. I can write the brief, help choose the right approach, coordinate the work and check it carefully before launch.",
  },
];

const supporting = [
  ["Digital strategy", "Decide which digital work matters now, what can wait and why."],
  ["UX and content structure", "Arrange pages and content around what visitors are trying to find or do."],
  ["Web design and CMS delivery", "Responsive websites built in Squarespace, Wix, Webflow, Framer, Odoo, Shopify or WordPress."],
  ["Digital marketing", "Plan and run paid search, social or email campaigns with a clear purpose."],
  ["SEO", "Improve page content, site structure and the technical details that help search engines understand the website."],
  ["AI and prompt support", "Use AI for research, analysis and repeatable tasks where it genuinely saves time."],
  ["Consultation", "Bring me a problem or decision and I will help you work through it."],
];
---

<BaseLayout
  title="Business Analysis & Digital Project Management Services"
  description="Business analysis, digital project management and website project management from Simon Spitz, with hands-on support across UX, content, web design and SEO."
>
  <PageIntro
    eyebrow="What I do"
    title="Business analysis and project management for digital projects."
    intro="I can help before a project has a proper brief, when the work needs organising or when a website needs to be planned and delivered. You can bring me in for one part of the job or ask me to manage it from start to finish."
  />

  <section class="section-space bg-mist">
    <div class="page-shell space-y-20 lg:space-y-28">
      {
        areas.map((area) => (
          <article class="grid gap-7 lg:grid-cols-[0.42fr_1.58fr] lg:gap-20">
            <p class="eyebrow text-charcoal-soft">{area.number}</p>
            <div>
              <h2 class="content-heading max-w-[14ch]">{area.title}</h2>
              <p class="mt-6 max-w-2xl text-xl font-bold leading-8">{area.intro}</p>
              <p class="content-copy mt-6">{area.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-space">
    <div class="page-shell">
      <p class="eyebrow text-charcoal-soft">Other areas I can cover</p>
      <h2 class="content-heading mt-6 max-w-[13ch]">Other parts of the project I can cover.</h2>
      <div class="mt-14 grid gap-x-14 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          supporting.map(([title, text], index) => (
            <article>
              <p class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="mt-4 text-2xl font-semibold">{title}</h3>
              <p class="mt-4 leading-7 text-charcoal-soft">{text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-12 sm:pb-16">
    <div class="page-shell">
      <div class="grid gap-8 rounded-[2rem] bg-mist px-7 py-10 shadow-soft sm:px-10 sm:py-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-end lg:gap-20 lg:px-14 lg:py-16">
        <div>
          <p class="eyebrow text-charcoal-soft">A specialist service</p>
          <h2 class="mt-5 max-w-[12ch] text-[clamp(2.5rem,4.5vw,4.75rem)] font-semibold leading-[0.98] tracking-[-0.035em]">
            Reach the people job ads miss.
          </h2>
        </div>
        <div>
          <p class="max-w-2xl text-[clamp(1.1rem,1.5vw,1.3rem)] leading-8 text-charcoal-soft">
            Social recruiting is a separate service I deliver with a business partner. We plan and run targeted social media campaigns designed to reach suitable people, including those who are not actively searching job boards.
          </p>
          <a class="text-link mt-7" href="/social-recruiting/">See how social recruiting works <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction title="Not sure where to start?" text="Tell me what is happening and I can help you work out what kind of support would be useful." />
</BaseLayout>
