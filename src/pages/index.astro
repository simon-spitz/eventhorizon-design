---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import { recentProjects } from "../data/projects";
import heroImage from "../assets/images/home/hero.jpg";
import simonPortrait from "../assets/images/home/simon-spitz.webp";

const capabilities = [
  {
    title: "Business analysis",
    description:
      "I help you work out what the organisation and its users actually need, then turn that into requirements people can use.",
  },
  {
    title: "Digital project management",
    description:
      "I keep the brief, decisions, people and deadlines organised from the first conversation through to handover.",
  },
  {
    title: "Website project management",
    description:
      "I can plan the website, coordinate content and suppliers, review the work and keep the project heading towards launch.",
  },
  {
    title: "UX and content structure",
    description:
      "I arrange pages and content around the questions people bring to the website.",
  },
  {
    title: "Web design and CMS delivery",
    description:
      "I design and build responsive websites in a CMS that your team can manage after launch.",
  },
  {
    title: "Digital marketing and SEO",
    description:
      "I improve search visibility and plan campaigns around what the website needs to achieve.",
  },
];

const siteUrl = "https://www.eventhorizon-design.com/";
const homeStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Event Horizon Design",
      alternateName: ["Simon Spitz", "eventhorizon-design.com"],
      inLanguage: "en-GB",
      publisher: { "@id": `${siteUrl}#organisation` },
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organisation`,
      name: "Event Horizon Design",
      url: siteUrl,
      telephone: "+447563165406",
      founder: { "@id": `${siteUrl}#simon-spitz` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#simon-spitz`,
      name: "Simon Spitz",
      url: `${siteUrl}about/`,
      jobTitle: "Freelance business analyst and digital project manager",
      description: "Business analyst and digital project manager specialising in website projects.",
      telephone: "+447563165406",
      sameAs: ["https://www.linkedin.com/in/simon-spitz"],
      knowsAbout: ["Business analysis", "Digital project management", "Website project management", "Web development", "Programming", "Databases", "Server-side technologies", "Web design", "Digital marketing", "SEO", "Social recruiting"],
      worksFor: { "@id": `${siteUrl}#organisation` },
    },
  ],
};
---

<BaseLayout
  title="Simon Spitz | Freelance Business Analyst & Digital Project Manager"
  description="Simon Spitz is a freelance business analyst and digital project manager who helps organisations plan and deliver website projects."
  structuredData={homeStructuredData}
>
  <section class="page-shell grid items-center gap-12 py-14 sm:py-20 lg:min-h-[calc(100svh-7rem)] lg:grid-cols-[1.03fr_0.97fr] lg:gap-16 lg:py-24">
    <div class="max-w-4xl">
      <p class="eyebrow mb-7 text-charcoal-soft">Business analysis · Project management · Websites</p>
      <h1 class="max-w-[11ch] font-display text-[clamp(3.2rem,7.4vw,7.4rem)] font-semibold leading-[0.9] tracking-[-0.045em]">
        I help organisations plan and deliver digital projects.
      </h1>
      <p class="mt-8 max-w-[43rem] text-[clamp(1.1rem,1.7vw,1.42rem)] leading-[1.65] text-charcoal-soft">
        I’m Simon Spitz, the person behind Event Horizon Design. I work as a freelance business analyst and digital project manager, specialising in website projects. I help organisations work out what they need and see the project through.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a class="button-dark" href="/contact/">Discuss a project</a>
        <a class="text-link" href="#how-i-help">See how I help <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="relative lg:justify-self-end">
      <div class="absolute -inset-5 -z-10 rounded-[2.5rem] bg-mist sm:-inset-8"></div>
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        widths={[480, 640, 768, 960, 1280]}
        sizes="(max-width: 1023px) calc(100vw - 2rem), 44vw"
        alt="Man writing notes beside a laptop on a bright office desk"
        priority
        quality={82}
        class="aspect-[4/5] w-full rounded-[2rem] object-cover object-center shadow-lifted sm:aspect-[5/4] lg:aspect-[4/5] lg:max-h-[44rem]"
      />
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell grid items-center gap-12 md:grid-cols-[0.72fr_1.28fr] md:gap-16 lg:gap-24">
      <div class="mx-auto w-full max-w-sm">
        <Image
          src={simonPortrait}
          alt="Simon Spitz"
          widths={[320, 500, 750]}
          sizes="(max-width: 767px) min(78vw, 24rem), 30vw"
          layout="constrained"
          quality={86}
          class="aspect-square w-full rounded-full object-cover shadow-soft"
        />
      </div>

      <div class="max-w-3xl">
        <p class="eyebrow text-charcoal-soft">Why I work this way</p>
        <blockquote class="mt-7 font-display text-[clamp(2rem,4vw,4.25rem)] font-semibold leading-[1.08] tracking-[-0.025em]">
          “I ask questions, get the right people talking and keep the work moving.”
        </blockquote>
        <p class="mt-8 max-w-2xl text-[clamp(1.05rem,1.5vw,1.25rem)] leading-8 text-charcoal-soft">
          I have worked in web development, project management, digital marketing and SEO for more than 20 years. I understand the technical detail without losing sight of what the project is meant to achieve.
        </p>
        <a class="text-link mt-9" href="/about/">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="how-i-help" class="section-space scroll-mt-24">
    <div class="page-shell">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-36 lg:self-start">
          <p class="eyebrow text-charcoal-soft">How I help</p>
          <h2 class="mt-5 max-w-[11ch] text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            What I can take on.
          </h2>
          <a class="text-link mt-9" href="/digital-solutions/">See what I do <span aria-hidden="true">→</span></a>
        </div>

        <ol class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
          {
            capabilities.map((capability, index) => (
              <li class="min-h-48 py-2">
                <p class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="mt-4 text-[clamp(1.55rem,2.3vw,2.15rem)] font-semibold leading-tight tracking-[-0.015em]">
                  {capability.title}
                </h3>
                <p class="mt-4 text-[1.03rem] leading-7 text-charcoal-soft">{capability.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell">
      <div class="flex flex-col items-start justify-between gap-7 md:flex-row md:items-end">
        <div>
          <p class="eyebrow text-charcoal-soft">Selected website work</p>
          <h2 class="mt-5 text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            Recent projects.
          </h2>
        </div>
        <a class="text-link" href="/portfolio/">View selected work <span aria-hidden="true">→</span></a>
      </div>

      <ol class="mt-14 lg:mt-20">
        {
          recentProjects.map((project, index) => (
            <li class="group py-7 first:pt-0 last:pb-0 sm:py-9">
              <a
                href={`/portfolio/#${project.slug}`}
                class="grid items-baseline gap-3 sm:grid-cols-[4rem_1fr_auto] sm:gap-8"
              >
                <span class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</span>
                <span class="font-display text-[clamp(2rem,4.5vw,4.5rem)] font-semibold leading-none tracking-[-0.03em] transition-opacity group-hover:opacity-55">
                  {project.title}
                </span>
                <span class="mt-2 text-sm font-bold text-charcoal-soft sm:mt-0">
                  {project.services.slice(0, 2).join(" · ")} <span aria-hidden="true" class="ml-2">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="page-shell">
      <div class="grid gap-8 rounded-[2rem] bg-mist px-7 py-10 shadow-soft sm:px-10 sm:py-12 lg:grid-cols-[0.7fr_1.3fr] lg:items-end lg:gap-16 lg:px-14">
        <div>
          <p class="eyebrow text-charcoal-soft">Specialist service</p>
          <h2 class="mt-5 text-[clamp(2.25rem,4vw,4.25rem)] font-semibold leading-[0.98] tracking-[-0.03em]">
            Social recruiting.
          </h2>
        </div>
        <div>
          <p class="max-w-2xl text-[clamp(1.1rem,1.5vw,1.3rem)] leading-8 text-charcoal-soft">
            Together with a specialist business partner, I run focused social media campaigns for employers who need to reach potential candidates beyond job boards.
          </p>
          <a class="text-link mt-7" href="/social-recruiting/">Explore social recruiting <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
