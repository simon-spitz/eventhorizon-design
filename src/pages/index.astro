---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/images/home/hero.webp";
import simonPortrait from "../assets/images/home/simon-spitz.webp";
import transitionImage from "../assets/images/home/transition-expertise.webp";
import thaImage from "../assets/images/home/tha.webp";
import agencyImage from "../assets/images/home/102-agency.webp";
import remImage from "../assets/images/home/rem-core-drilling.webp";

const services = [
  {
    title: "Digital marketing",
    description:
      "Paid search, social campaigns and email marketing designed to reach the right audience and deliver measurable results.",
  },
  {
    title: "Search engine optimisation",
    description:
      "Improve your search visibility and attract the right B2B audience with focused SEO.",
  },
  {
    title: "User experience",
    description:
      "Make your website intuitive, clear and engaging for the people who use it.",
  },
  {
    title: "Web design for businesses",
    description:
      "Responsive websites shaped around the needs of your business and customers.",
  },
  {
    title: "AI support for smarter marketing",
    description:
      "Use tools such as ChatGPT to create stronger content, save time and simplify marketing—without technical jargon.",
  },
  {
    title: "Consultation",
    description:
      "Practical advice to strengthen your digital presence and tackle business challenges.",
  },
  {
    title: "Content management systems",
    description:
      "Flexible, user-friendly systems that make your website straightforward to update.",
  },
  {
    title: "Social recruiting",
    description:
      "AI-supported social recruitment that helps you connect with the right talent efficiently.",
  },
];

const projects = [
  {
    title: "Transition Expertise",
    href: "/portfolio/transition-expertise/",
    image: transitionImage,
    alt: "Transition Expertise website preview",
  },
  {
    title: "THA Titleholders Association",
    href: "/portfolio/tha-park-ecovillage/",
    image: thaImage,
    alt: "THA Titleholders Association website preview",
  },
  {
    title: "102 Recruiting Agency",
    href: "/portfolio/102-agency/",
    image: agencyImage,
    alt: "102 Recruiting Agency website preview",
  },
  {
    title: "REM Core Drilling",
    href: "/portfolio/rem-core-drilling/",
    image: remImage,
    alt: "REM Core Drilling website preview",
  },
];
---

<BaseLayout
  title="Digital Marketing and Web Design | Event Horizon Design"
  description="Independent B2B and B2C digital marketing, web design, SEO and strategic support from Event Horizon Design."
>
  <section class="page-shell grid items-center gap-12 py-14 sm:py-20 lg:min-h-[calc(100svh-6rem)] lg:grid-cols-[1.03fr_0.97fr] lg:gap-16 lg:py-24">
    <div class="max-w-4xl">
      <p class="eyebrow mb-7 text-charcoal-soft">B2B · B2C · Web · Strategy</p>
      <h1 class="max-w-[12ch] font-display text-[clamp(3.2rem,7.4vw,7.4rem)] font-semibold leading-[0.9] tracking-[-0.045em]">
        Digital work that gets results.
      </h1>
      <p class="mt-8 max-w-[42rem] text-[clamp(1.1rem,1.7vw,1.42rem)] leading-[1.65] text-charcoal-soft">
        Experienced digital marketing, web design and practical strategic support for B2B and B2C brands.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a class="button-dark" href="/contact/">Start a conversation</a>
        <a class="text-link" href="#services">Explore my services <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="relative lg:justify-self-end">
      <div class="absolute -inset-5 -z-10 rounded-[2.5rem] bg-mist sm:-inset-8"></div>
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        widths={[480, 640, 768, 960, 1280]}
        sizes="(max-width: 1023px) calc(100vw - 2rem), 44vw"
        alt=""
        priority
        quality={82}
        class="aspect-[4/5] w-full rounded-[2rem] object-cover object-[49%_14%] shadow-lifted sm:aspect-[5/4] lg:aspect-[4/5] lg:max-h-[44rem]"
      />
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell grid items-center gap-12 md:grid-cols-[0.72fr_1.28fr] md:gap-16 lg:gap-24">
      <div class="mx-auto w-full max-w-sm">
        <Image
          src={simonPortrait}
          alt="Simon Spitz"
          widths={[320, 500, 750]}
          sizes="(max-width: 767px) min(78vw, 24rem), 30vw"
          layout="constrained"
          quality={86}
          class="aspect-square w-full rounded-full object-cover shadow-soft"
        />
      </div>

      <div class="max-w-3xl">
        <p class="eyebrow text-charcoal-soft">Event Horizon Design</p>
        <blockquote class="mt-7 font-display text-[clamp(2rem,4vw,4.25rem)] font-semibold leading-[1.08] tracking-[-0.025em]">
          “I bring more than 20 years of B2B and B2C experience to digital marketing and web design.”
        </blockquote>
        <p class="mt-8 max-w-2xl text-[clamp(1.05rem,1.5vw,1.25rem)] leading-8 text-charcoal-soft">
          From focused marketing strategy to modern websites, I help businesses strengthen their digital presence and achieve meaningful results.
        </p>
        <a class="text-link mt-9" href="/about/">About my approach <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="services" class="section-space scroll-mt-24">
    <div class="page-shell">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-36 lg:self-start">
          <p class="eyebrow text-charcoal-soft">Key services</p>
          <h2 class="mt-5 max-w-[10ch] text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            Clear thinking. Useful work.
          </h2>
          <a class="text-link mt-9" href="/digital-solutions/">View all services <span aria-hidden="true">→</span></a>
        </div>

        <ol class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
          {
            services.map((service, index) => (
              <li class="group min-h-48 py-2">
                <p class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="mt-4 text-[clamp(1.55rem,2.3vw,2.15rem)] font-semibold leading-tight tracking-[-0.015em]">
                  {service.title}
                </h3>
                <p class="mt-4 text-[1.03rem] leading-7 text-charcoal-soft">
                  {service.description}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell">
      <div class="flex flex-col items-start justify-between gap-7 md:flex-row md:items-end">
        <div>
          <p class="eyebrow text-charcoal-soft">Selected projects</p>
          <h2 class="mt-5 text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            Some of my work.
          </h2>
        </div>
        <a class="text-link" href="/portfolio/">View my portfolio <span aria-hidden="true">→</span></a>
      </div>

      <div class="mt-14 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:mt-20">
        {
          projects.map((project) => (
            <a href={project.href} class="group block">
              <Picture
                src={project.image}
                formats={["avif", "webp"]}
                widths={[400, 600, 800, 960]}
                sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 2.5rem), 42rem"
                alt={project.alt}
                quality={84}
                class="aspect-[16/10] w-full rounded-[1.5rem] object-cover shadow-soft transition duration-300 group-hover:-translate-y-1 group-hover:shadow-lifted"
              />
              <h3 class="mt-6 flex items-center justify-between gap-4 text-[clamp(1.45rem,2.5vw,2.15rem)] font-semibold">
                <span>{project.title}</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="page-shell text-center">
      <p class="eyebrow text-charcoal-soft">Start a conversation</p>
      <h2 class="mx-auto mt-6 max-w-[13ch] text-[clamp(2.8rem,6vw,6rem)] font-semibold leading-[0.94] tracking-[-0.04em]">
        Ready to improve your digital presence?
      </h2>
      <p class="mx-auto mt-8 max-w-2xl text-[clamp(1.05rem,1.5vw,1.25rem)] leading-8 text-charcoal-soft">
        Tell me what you are working on and what you would like to achieve.
      </p>
      <a class="button-dark mt-10" href="/contact/">Get in touch</a>
    </div>
  </section>
</BaseLayout>
