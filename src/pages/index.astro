---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import heroImage from "../assets/images/home/hero.webp";
import simonPortrait from "../assets/images/home/simon-spitz.webp";

const capabilities = [
  {
    title: "Business analysis",
    description:
      "Clarify the real need, map requirements and turn competing perspectives into a workable direction.",
  },
  {
    title: "Digital project management",
    description:
      "Keep people, priorities, decisions and delivery moving together from initial brief to finished result.",
  },
  {
    title: "Website project management",
    description:
      "Shape the brief, coordinate content and suppliers, manage quality and guide a website through to launch.",
  },
  {
    title: "UX and content structure",
    description:
      "Organise information around what users need so digital experiences feel clear, useful and easy to navigate.",
  },
  {
    title: "Web design and CMS delivery",
    description:
      "Create responsive websites and practical content systems that suit the organisation behind them.",
  },
  {
    title: "Digital marketing and SEO",
    description:
      "Connect the website to focused search, campaign and content work that supports wider business goals.",
  },
];
---

<BaseLayout
  title="Simon Spitz | Business Analyst and Digital Project Manager"
  description="Independent business analysis, digital and website project management, web design and digital support from Simon Spitz."
>
  <section class="page-shell grid items-center gap-12 py-14 sm:py-20 lg:min-h-[calc(100svh-7rem)] lg:grid-cols-[1.03fr_0.97fr] lg:gap-16 lg:py-24">
    <div class="max-w-4xl">
      <p class="eyebrow mb-7 text-charcoal-soft">Business analysis · Project leadership · Digital delivery</p>
      <h1 class="max-w-[11ch] font-display text-[clamp(3.2rem,7.4vw,7.4rem)] font-semibold leading-[0.9] tracking-[-0.045em]">
        Clarity for complex digital work.
      </h1>
      <p class="mt-8 max-w-[43rem] text-[clamp(1.1rem,1.7vw,1.42rem)] leading-[1.65] text-charcoal-soft">
        I’m Simon Spitz, an independent business analyst, digital project manager and website specialist. I help organisations turn loosely defined needs into practical plans—and carry them through to delivery.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a class="button-dark" href="/contact/">Discuss a project</a>
        <a class="text-link" href="#how-i-help">See how I help <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="relative lg:justify-self-end">
      <div class="absolute -inset-5 -z-10 rounded-[2.5rem] bg-mist sm:-inset-8"></div>
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        widths={[480, 640, 768, 960, 1280]}
        sizes="(max-width: 1023px) calc(100vw - 2rem), 44vw"
        alt="A digital project plan being sketched on a whiteboard"
        priority
        quality={82}
        class="aspect-[4/5] w-full rounded-[2rem] object-cover object-[49%_14%] shadow-lifted sm:aspect-[5/4] lg:aspect-[4/5] lg:max-h-[44rem]"
      />
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell grid items-center gap-12 md:grid-cols-[0.72fr_1.28fr] md:gap-16 lg:gap-24">
      <div class="mx-auto w-full max-w-sm">
        <Image
          src={simonPortrait}
          alt="Simon Spitz"
          widths={[320, 500, 750]}
          sizes="(max-width: 767px) min(78vw, 24rem), 30vw"
          layout="constrained"
          quality={86}
          class="aspect-square w-full rounded-full object-cover shadow-soft"
        />
      </div>

      <div class="max-w-3xl">
        <p class="eyebrow text-charcoal-soft">A personal, joined-up approach</p>
        <blockquote class="mt-7 font-display text-[clamp(2rem,4vw,4.25rem)] font-semibold leading-[1.08] tracking-[-0.025em]">
          “I work in the space between business goals, people and technology.”
        </blockquote>
        <p class="mt-8 max-w-2xl text-[clamp(1.05rem,1.5vw,1.25rem)] leading-8 text-charcoal-soft">
          More than 20 years across web development, project management, digital marketing and SEO help me see both the strategic question and the practical work needed to answer it.
        </p>
        <a class="text-link mt-9" href="/about/">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section id="how-i-help" class="section-space scroll-mt-24">
    <div class="page-shell">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-36 lg:self-start">
          <p class="eyebrow text-charcoal-soft">How I help</p>
          <h2 class="mt-5 max-w-[11ch] text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            From unclear brief to useful result.
          </h2>
          <a class="text-link mt-9" href="/digital-solutions/">Explore my capabilities <span aria-hidden="true">→</span></a>
        </div>

        <ol class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
          {
            capabilities.map((capability, index) => (
              <li class="min-h-48 py-2">
                <p class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</p>
                <h3 class="mt-4 text-[clamp(1.55rem,2.3vw,2.15rem)] font-semibold leading-tight tracking-[-0.015em]">
                  {capability.title}
                </h3>
                <p class="mt-4 text-[1.03rem] leading-7 text-charcoal-soft">{capability.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell">
      <div class="flex flex-col items-start justify-between gap-7 md:flex-row md:items-end">
        <div>
          <p class="eyebrow text-charcoal-soft">Selected website work</p>
          <h2 class="mt-5 text-[clamp(2.8rem,5vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.035em]">
            Projects brought to life.
          </h2>
        </div>
        <a class="text-link" href="/portfolio/">View all work <span aria-hidden="true">→</span></a>
      </div>

      <div class="mt-14 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:mt-20">
        {projects.slice(0, 4).map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
