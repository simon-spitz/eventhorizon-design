---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CallToAction from "../../components/CallToAction.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const site = Astro.site ?? new URL("https://www.eventhorizon-design.com");
const pageUrl = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(project.desktop.src, site).href;
const projectStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: `${project.shortTitle} website project`,
      description: project.summary,
      inLanguage: "en-GB",
      isPartOf: { "@id": "https://www.eventhorizon-design.com/#website" },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: imageUrl,
      },
      mainEntity: { "@id": `${pageUrl}#project` },
    },
    {
      "@type": "CreativeWork",
      "@id": `${pageUrl}#project`,
      name: project.title,
      description: project.summary,
      image: imageUrl,
      creator: { "@id": "https://www.eventhorizon-design.com/#simon-spitz" },
      ...(project.url ? { sameAs: project.url } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://www.eventhorizon-design.com/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Work",
          item: "https://www.eventhorizon-design.com/portfolio/",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: project.shortTitle,
          item: pageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${project.shortTitle} Website Project | Simon Spitz`}
  description={`${project.summary} Selected website work by Simon Spitz.`}
  structuredData={projectStructuredData}
>
  <section class="page-shell pb-16 pt-16 sm:pb-24 sm:pt-24 lg:pb-28 lg:pt-28">
    <a class="text-link" href="/portfolio/"><span aria-hidden="true">←</span> All work</a>
    <p class="eyebrow mt-14 text-charcoal-soft">Selected website project</p>
    <h1 class="mt-6 max-w-[14ch] text-[clamp(3.2rem,7vw,7rem)] font-semibold leading-[0.9] tracking-[-0.045em]">
      {project.title}
    </h1>
    <div class="mt-10 flex flex-wrap gap-x-12 gap-y-5 text-lg">
      <p><span class="text-charcoal-soft">Project</span><br /><strong>{project.kind}</strong></p>
      <p><span class="text-charcoal-soft">Platform</span><br /><strong>{project.cms}</strong></p>
      {
        project.url && (
          <p>
            <span class="text-charcoal-soft">Website</span><br />
            <a class="text-link" href={project.url} rel="noopener">Visit project <span aria-hidden="true">↗</span></a>
          </p>
        )
      }
    </div>
    <p class="content-copy mt-10">{project.summary}</p>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell">
      <Picture
        src={project.desktop}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1023px) calc(100vw - 2rem), min(86rem, calc(100vw - 5rem))"
        alt={`Desktop view of the ${project.shortTitle} website`}
        quality={86}
        class="h-auto w-full rounded-[2rem] shadow-lifted"
      />

      <div class="mt-12 grid items-start gap-8 sm:grid-cols-3 lg:mt-20 lg:gap-14">
        {
          project.phones.map((image, index) => (
            <Picture
              src={image}
              formats={["avif", "webp"]}
              widths={[280, 420, 600]}
              sizes="(max-width: 639px) min(76vw, 28rem), 28vw"
              alt={`Mobile view ${index + 1} of the ${project.shortTitle} website`}
              quality={84}
              class="mx-auto h-auto w-full max-w-md rounded-[1.5rem] shadow-soft"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="page-shell text-center">
      <p class="eyebrow text-charcoal-soft">Next project</p>
      <a
        href={`/portfolio/${nextProject.slug}/`}
        class="mx-auto mt-6 inline-flex items-center gap-5 font-display text-[clamp(2.5rem,5vw,5rem)] font-semibold leading-none transition-opacity hover:opacity-55"
      >
        {nextProject.shortTitle} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <CallToAction />
</BaseLayout>
