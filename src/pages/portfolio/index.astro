---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CallToAction from "../../components/CallToAction.astro";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Website Project Portfolio | Simon Spitz"
  description="Selected website projects by Simon Spitz, showing responsive work for businesses and organisations delivered with Squarespace and Odoo."
>
  <PageIntro
    eyebrow="Selected work"
    title="Selected website projects."
    intro="Here are some of the website projects I have worked on for businesses and organisations. They include Squarespace and Odoo websites designed for desktop and mobile."
  />

  <section class="section-space bg-mist">
    <div class="page-shell grid gap-x-10 gap-y-16 sm:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <CallToAction title="Need help with a website project?" />
</BaseLayout>
