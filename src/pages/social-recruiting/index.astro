---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CallToAction from "../../components/CallToAction.astro";

const benefits = [
  {
    title: "Use the budget more carefully",
    text: "A focused social campaign can sit alongside job boards or recruitment agencies and give you another way to reach people.",
  },
  {
    title: "Reach people who are not job hunting",
    text: "A suitable candidate may not be looking at job listings. Social advertising can still put the vacancy in front of them.",
  },
  {
    title: "Show the vacancy to a more specific audience",
    text: "Campaigns can be narrowed by location, interests and other relevant criteria rather than shown to everyone.",
  },
];
---

<BaseLayout
  title="Social Recruiting Support for Employers | Simon Spitz"
  description="Social recruiting support for employers, using focused digital campaigns to reach relevant candidates beyond traditional recruitment channels."
>
  <PageIntro
    eyebrow="Specialist capability"
    title="Social recruiting support for employers."
    intro="I help businesses advertise vacancies through social media. We start with the role and the people you want to reach, then decide which platforms and campaign setup make sense."
  />

  <section class="section-space bg-mist">
    <div class="page-shell">
      <p class="eyebrow text-charcoal-soft">Why social recruiting?</p>
      <div class="mt-12 grid gap-14 lg:grid-cols-3 lg:gap-16">
        {
          benefits.map((benefit, index) => (
            <article>
              <p class="eyebrow text-charcoal-soft">{String(index + 1).padStart(2, "0")}</p>
              <h2 class="mt-5 text-3xl font-semibold leading-tight">{benefit.title}</h2>
              <p class="mt-5 leading-8 text-charcoal-soft">{benefit.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
      <p class="eyebrow text-charcoal-soft">When it can help</p>
      <div>
        <h2 class="content-heading max-w-[14ch]">Start with the vacancy, not the advertising.</h2>
        <p class="content-copy mt-8">Social recruiting can work for a small business or a larger organisation, but it is not the right answer for every vacancy. I look at the role, location, audience and other recruitment options before recommending it.</p>
      </div>
    </div>
  </section>

  <CallToAction title="Looking for a different way to reach candidates?" text="Tell me about the role and who you are trying to reach." />
</BaseLayout>
