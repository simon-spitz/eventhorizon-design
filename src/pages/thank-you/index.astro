---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | Event Horizon Design"
  description="Thank you for contacting Simon Spitz at Event Horizon Design."
  robots="noindex, follow"
>
  <section class="page-shell flex min-h-[65svh] flex-col items-start justify-center py-20">
    <p class="eyebrow text-charcoal-soft">Message sent</p>
    <h1 class="mt-6 max-w-[12ch] text-[clamp(3.2rem,7vw,7rem)] font-semibold leading-[0.9] tracking-[-0.045em]">
      Thank you. I’ll be in touch.
    </h1>
    <p class="content-copy mt-8">Your message has been received. I’ll read it carefully and respond as soon as I can.</p>
    <a class="text-link mt-9" href="/">Return home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
