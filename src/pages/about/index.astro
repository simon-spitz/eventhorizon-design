---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import CallToAction from "../../components/CallToAction.astro";
import simonPortrait from "../../assets/images/simon-about.webp";

const siteUrl = "https://www.eventhorizon-design.com/";
const profileStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${siteUrl}about/#profile-page`,
  url: `${siteUrl}about/`,
  name: "About Simon Spitz",
  inLanguage: "en-GB",
  mainEntity: {
    "@type": "Person",
    "@id": `${siteUrl}#simon-spitz`,
    name: "Simon Spitz",
    url: `${siteUrl}about/`,
    jobTitle: "Freelance business analyst and digital project manager",
    description: "Business analyst and digital project manager specialising in website projects, with more than 20 years of digital experience.",
    knowsAbout: ["Business analysis", "Digital project management", "Website project management", "Web development", "Programming", "Databases", "Server-side technologies", "Digital marketing", "SEO", "AI search visibility", "Prompt engineering"],
    sameAs: ["https://www.linkedin.com/in/simon-spitz"],
  },
};
---

<BaseLayout
  title="About Simon Spitz | Business Analyst & Digital Project Manager"
  description="Meet Simon Spitz, a freelance business analyst and digital project manager with more than 20 years in digital work and a practical approach to AI."
  structuredData={profileStructuredData}
>
  <PageIntro
    eyebrow="About"
    title="I’m Simon Spitz."
    intro="I work as a freelance business analyst and digital project manager, helping organisations turn ideas and requirements into practical digital projects. I ask questions, bring the right people and information together, and keep the work moving from the first decisions through to delivery. Event Horizon Design is the name of my business, and you work directly with me."
  />

  <section class="section-space bg-mist">
    <div class="page-shell grid items-center gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16 lg:gap-24">
      <Image
        src={simonPortrait}
        alt="Simon Spitz"
        widths={[420, 640, 900]}
        sizes="(max-width: 767px) calc(100vw - 2rem), 38vw"
        layout="constrained"
        quality={86}
        class="aspect-[4/5] w-full rounded-[2rem] object-cover shadow-soft"
      />
      <div>
        <p class="eyebrow text-charcoal-soft">How I got here</p>
        <h2 class="content-heading mt-6">I started with websites. The work grew from there.</h2>
        <div class="content-copy mt-8 space-y-6">
          <p>I began as a web developer, designing and coding websites. My technical background also includes programming, databases, server-side technologies and current web development tools and practices. I do not need to be the developer on every project, but I understand how the parts fit together and can work effectively with technical teams.</p>
          <p>I later moved into project management and led complex web development projects. That taught me that technology is usually only one part of the job. Clear decisions, realistic plans and honest communication matter just as much.</p>
          <p>Working in digital marketing and SEO taught me to look beyond the launch. A website has to help the organisation and be useful to the people visiting it.</p>
          <p>AI is now part of my toolkit. I use ChatGPT and Claude to help with research, analysis, content planning and repeatable tasks. I design and test prompts, check the results and keep responsibility for the decisions.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="page-shell grid gap-14 lg:grid-cols-3 lg:gap-16">
      <article>
        <p class="eyebrow text-charcoal-soft">01 · Listen</p>
        <h2 class="mt-5 text-3xl font-semibold">Start with what is actually happening.</h2>
        <p class="mt-5 leading-8 text-charcoal-soft">I talk to the people involved, look at the current situation and check the assumptions before suggesting a solution.</p>
      </article>
      <article>
        <p class="eyebrow text-charcoal-soft">02 · Organise</p>
        <h2 class="mt-5 text-3xl font-semibold">Agree what happens next.</h2>
        <p class="mt-5 leading-8 text-charcoal-soft">I turn what we know into priorities, decisions and manageable pieces of work.</p>
      </article>
      <article>
        <p class="eyebrow text-charcoal-soft">03 · Deliver</p>
        <h2 class="mt-5 text-3xl font-semibold">Keep the work moving.</h2>
        <p class="mt-5 leading-8 text-charcoal-soft">I coordinate the project, deal with the practical digital details and bring in a specialist when the work genuinely needs one.</p>
      </article>
    </div>
  </section>

  <section class="section-space bg-mist">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-24">
      <p class="eyebrow text-charcoal-soft">How I work</p>
      <div>
        <blockquote class="content-heading">I keep the work and the communication straightforward.</blockquote>
        <p class="content-copy mt-8">I keep communication simple, explain my recommendations and adapt the work to what the project needs rather than pushing a fixed package.</p>
        <a class="text-link mt-8" href="/contact/">Discuss a project <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CallToAction title="Tell me what you are working on." />
</BaseLayout>
