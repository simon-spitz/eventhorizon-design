---
import { Picture } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a href={`/portfolio/${project.slug}/`} class="group block">
  <Picture
    src={project.cover}
    formats={["avif", "webp"]}
    widths={[400, 600, 800, 960]}
    sizes="(max-width: 639px) calc(100vw - 2rem), (max-width: 1023px) calc(50vw - 2.5rem), 42rem"
    alt={`${project.shortTitle} website preview`}
    quality={84}
    class="aspect-[16/10] w-full rounded-[1.5rem] object-cover shadow-soft transition duration-300 group-hover:-translate-y-1 group-hover:shadow-lifted"
  />
  <p class="eyebrow mt-6 text-charcoal-soft">{project.kind} · {project.cms}</p>
  <h2 class="mt-3 flex items-center justify-between gap-4 text-[clamp(1.55rem,2.5vw,2.2rem)] font-semibold leading-tight">
    <span>{project.shortTitle}</span>
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
  </h2>
</a>
