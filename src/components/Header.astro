---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.webp";

const navigation = [
  { label: "Home", href: "/" },
  { label: "What I do", href: "/digital-solutions/" },
  { label: "Work", href: "/portfolio/" },
  { label: "About", href: "/about/" },
  { label: "Contact", href: "/contact/" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header
  class="sticky top-0 z-50 bg-white/94 shadow-[0_18px_48px_-44px_rgba(41,42,40,0.7)] backdrop-blur-md"
>
  <div
    class="page-shell flex min-h-24 items-center justify-between py-3 lg:grid lg:min-h-28 lg:grid-cols-[1fr_auto_1fr] lg:py-2"
  >
    <a
      href="/"
      class="flex shrink-0 items-center gap-4 justify-self-start transition-opacity hover:opacity-60"
      aria-label="Event Horizon Design home"
    >
      <Image
        src={logo}
        alt="Event Horizon Design"
        width={96}
        height={96}
        loading="eager"
        class="brand-logo h-20 w-20 object-contain lg:h-24 lg:w-24"
      />
      <span class="hidden font-display text-[1.05rem] font-semibold leading-[1.05] tracking-[-0.015em] text-charcoal xl:block">
        Event Horizon<br />Design
      </span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-10 lg:flex xl:gap-14">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class="nav-link relative py-3 text-[0.8rem] font-bold uppercase tracking-[0.15em] text-charcoal transition-opacity hover:opacity-50"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div aria-hidden="true" class="hidden lg:block"></div>

    <details class="mobile-menu relative lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-full px-3 text-sm font-bold [&::-webkit-details-marker]:hidden"
      >
        <span>Menu</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-[calc(100%+0.75rem)] flex w-[min(19rem,calc(100vw-2rem))] flex-col gap-1 rounded-[1.4rem] bg-white p-3 shadow-lifted"
      >
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class="rounded-xl px-4 py-3 text-lg font-bold transition-colors hover:bg-mist"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .brand-logo {
    filter: grayscale(1) saturate(0) brightness(0.2);
  }

  .nav-link::after {
    position: absolute;
    bottom: 0.15rem;
    left: 50%;
    width: 0.25rem;
    height: 0.25rem;
    content: "";
    background: currentColor;
    border-radius: 999px;
    opacity: 0;
    transform: translateX(-50%);
  }

  .nav-link[aria-current="page"]::after {
    opacity: 1;
  }

  .menu-icon {
    display: grid;
    width: 1.2rem;
    gap: 0.3rem;
  }

  .menu-icon i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .mobile-menu[open] .menu-icon i:first-child {
    transform: translateY(0.15rem) rotate(45deg);
  }

  .mobile-menu[open] .menu-icon i:last-child {
    transform: translateY(-0.15rem) rotate(-45deg);
  }
</style>
