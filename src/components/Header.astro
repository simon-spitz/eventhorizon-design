---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.webp";

const navigation = [
  { label: "Home", href: "/" },
  { label: "My Services", href: "/digital-solutions/" },
  { label: "About", href: "/about/" },
  { label: "Portfolio", href: "/portfolio/" },
  { label: "Contact", href: "/contact/" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 bg-white/94 shadow-[0_14px_42px_-34px_rgba(41,42,40,0.65)] backdrop-blur-md"
>
  <div class="page-shell flex min-h-20 items-center justify-between gap-6 py-3 lg:min-h-24">
    <a href="/" class="shrink-0" aria-label="Event Horizon Design home">
      <Image
        src={logo}
        alt="Event Horizon Design"
        width={64}
        height={64}
        loading="eager"
        class="brand-logo h-14 w-14 object-contain lg:h-16 lg:w-16"
      />
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-7 lg:flex xl:gap-10">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
            class="nav-link relative py-2 text-[0.92rem] font-bold tracking-[0.015em] text-charcoal transition-opacity hover:opacity-55"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu relative lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-full px-3 text-sm font-bold [&::-webkit-details-marker]:hidden"
      >
        <span>Menu</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-[calc(100%+0.75rem)] flex w-[min(19rem,calc(100vw-2rem))] flex-col gap-1 rounded-[1.4rem] bg-white p-3 shadow-lifted"
      >
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
              class="rounded-xl px-4 py-3 text-lg font-bold transition-colors hover:bg-mist"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .brand-logo {
    filter: grayscale(1) saturate(0) brightness(0.2);
  }

  .nav-link[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background: currentColor;
  }

  .menu-icon {
    display: grid;
    width: 1.2rem;
    gap: 0.3rem;
  }

  .menu-icon i {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .mobile-menu[open] .menu-icon i:first-child {
    transform: translateY(0.15rem) rotate(45deg);
  }

  .mobile-menu[open] .menu-icon i:last-child {
    transform: translateY(-0.15rem) rotate(-45deg);
  }
</style>
